{
  "name": "@lokiplay/mcp",
  "version": "0.5.5",
  "description": "Loki resources and tool definitions for MCP integrations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokilabs-ai/loki.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/lokilabs-ai/loki#readme",
  "bugs": "https://github.com/lokilabs-ai/loki/issues",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b --force && node ../../scripts/rewrite-package-imports.mjs dist",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lokiplay/protocol": "0.5.5"
  }
}
